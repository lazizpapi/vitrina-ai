# --- Telegram ---
BOT_TOKEN=8859007092:AAEuHqjn2nevkYTMpTizi1oq3ZEkWiFdpI8
# Public https base URL of this service (Railway domain). Used for Click callbacks.
PUBLIC_URL=https://vitrina.up.railway.app
# Optional: run the bot on a webhook instead of long polling
USE_WEBHOOK=false
WEBHOOK_SECRET=

# --- Higgsfield API (https://open.higgsfield.ai) ---
# Format: keyId:keySecret
HF_API_KEY=12cec4f5-53fa-4756-8c1e-4c629da30537:e1b6c03b19066f752fcaaefa85b7ee3f5329ed1b1475c1e62f3df29cc3cd7c40
HF_API_BASE_URL=https://api.higgsfield.ai
# Generations run at once. Higgsfield allows 2 under $25 added in the last
# 28 days, 10 from $25, 20 from $100. Raise this only after topping up.
HF_CONCURRENCY=2

# --- Anthropic (prompt writing, UZ/RU -> EN scene prompts) ---
# Read by the SDK directly. Leave blank to use an `ant auth login` profile.
ANTHROPIC_API_KEY=
# Per million tokens, input / output: claude-opus-5-5 $4 / $20,
# claude-sonnet-5-5 $2 / $10, claude-haiku-5-5 $0.10 / $0.50.
# Haiku has no refusal fallback, so a declined brief uses the template prompts.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Supabase (project: vitrina) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=vitrina

# --- Click.uz merchant (Shop API) ---
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Set false until the merchant contract is live; bot then offers Stars only.
CLICK_ENABLED=false

# --- Runtime ---
PORT=3000
ADMIN_TG_ID=
