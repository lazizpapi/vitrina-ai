# --- Telegram ---
BOT_TOKEN=
# Public https base URL of this service (Railway domain). Used for Click callbacks.
PUBLIC_URL=https://vitrina.up.railway.app
# Optional: run the bot on a webhook instead of long polling
USE_WEBHOOK=false
WEBHOOK_SECRET=

# --- Higgsfield API (https://open.higgsfield.ai) ---
# Format: keyId:keySecret
HF_API_KEY=
HF_API_BASE_URL=https://api.higgsfield.ai

# --- OpenAI (prompt writing, UZ/RU -> EN scene prompts) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# --- Supabase (project: vitrina) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=vitrina

# --- Click.uz merchant (Shop API) ---
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Set false until the merchant contract is live; bot then offers Stars only.
CLICK_ENABLED=false

# --- Runtime ---
PORT=3000
ADMIN_TG_ID=
