{
  "name": "vitrina-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marketplace product-card studio for Uzum/Wildberries/Ozon sellers, delivered as a Telegram bot.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "prestart": "node scripts/fetch-fonts.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@higgsfield/client": "^0.2.6",
    "@supabase/supabase-js": "^2.58.0",
    "dotenv": "^17.0.0",
    "grammy": "^1.40.0",
    "openai": "^6.0.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.28.2": true
  }
}
